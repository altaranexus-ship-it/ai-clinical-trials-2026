  "keywords": ["clinical trials", "artificial intelligence", "health AI", "market research", "ClinicalTrials.gov"],
  "license": "https://creativecommons.org/publicdomain/zero/1.0/",
  "creator": { "@type": "Organization", "name": "K-Dense Science Lab" },
  "temporalCoverage": "2019/2026",
  "variableMeasured": ["study_type", "phase", "sponsor_class", "country", "start_year", "condition"],
  "distribution": [
    { "@type": "DataDownload", "encodingFormat": "application/jsonl", "contentUrl": "https://github.com/altaranexus-ship-it/ai-clinical-trials-2026/tree/main/data" },
    { "@type": "DataDownload", "encodingFormat": "text/csv", "contentUrl": "https://github.com/altaranexus-ship-it/ai-clinical-trials-2026/tree/main/data" }
  ]
